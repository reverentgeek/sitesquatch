<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{% if fullTitle %}{{ fullTitle }}{% elif title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
	<meta name="description" content="{{ description or site.description }}">
	<meta name="generator" content="{{ ssqch.generator }}">
	{% if page.url and not noindex %}<link rel="canonical" href="{{ site.url }}{{ page.url }}">{% endif %}
	{% if noindex %}<meta name="robots" content="noindex">{% endif %}
	<link rel="icon" href="/favicon.svg" type="image/svg+xml">
	<link rel="alternate" type="application/atom+xml" href="/changelog/feed.xml" title="SiteSquatch changelog">
	{%- if docs %}
	{#- The page as Markdown, for agents (llmsPlugin in ssqch.config.js), and what describes the whole site to one. #}
	<link rel="alternate" type="text/markdown" href="{{ markdownCopy(page.url) }}">
	<link rel="describedby" href="/llms.txt">
	{%- endif %}
	<link rel="preload" href="/assets/fonts/caprasimo-latin.woff2" as="font" type="font/woff2" crossorigin>
	{% if docs %}<link rel="stylesheet" href="/highlight.css">{% endif %}
	<link rel="stylesheet" href="/assets/site.css">
	<script src="/assets/theme.js" defer></script>
	{#- Before the page is drawn, so a reader who picked a mode doesn't see the other one first. #}
	<script>try { const theme = localStorage.getItem("theme"); if (theme === "dark" || theme === "light") document.documentElement.dataset.theme = theme; } catch {}</script>
</head>
<body>
	<a class="skip-link" href="#main">Skip to the content</a>

	<header class="site-header">
		<div class="wrap">
			<a class="brand" href="/"><span class="patch" aria-hidden="true"></span>SiteSquatch</a>
			<nav class="site-nav" aria-label="Site">
				<a href="/docs/"{% if docs and "/docs/trailheads/" not in page.url %} aria-current="page"{% endif %}>Docs</a>
				<a href="/examples/"{% if page.url == "/examples/" %} aria-current="page"{% endif %}>Examples</a>
				<a href="/docs/trailheads/"{% if "/docs/trailheads/" in page.url %} aria-current="page"{% endif %}>Trailheads</a>
				<a href="{{ links.changelog }}"{% if "/changelog/" in page.url %} aria-current="page"{% endif %}>Trail log</a>
			</nav>
			<div class="header-tools">
				{#- Pagefind, when the search is first used (src/elements/site-search.js). Without
				    JavaScript, it's a link to every name on one page. #}
				<site-search ssqch:load="idle"><a class="search-link" href="/docs/reference/">Search the docs</a></site-search>
				{#- A panel with the site's links and the docs' sidebar (src/elements/site-menu.js), on a
				    narrow screen. Without JavaScript, it's a link to the sidebar or the footer. #}
				<site-menu ssqch:load="idle"><a class="menu-link" href="{% if docs %}#sidebar{% else %}#footer{% endif %}">Menu</a></site-menu>
				{#- theme.js shows it. Without JavaScript, the mode follows the system. #}
				<button class="theme-switch" type="button" hidden>Dark</button>
			</div>
		</div>
	</header>

	{%- if docs %}
{{ content }}
	{%- else %}
	<main id="main">
{{ content }}
	</main>
	{%- endif %}

	<footer class="site-footer" id="footer">
		<div class="wrap">
			<div>
				<a class="brand" href="/"><span class="patch" aria-hidden="true"></span>SiteSquatch</a>
				<p class="ranger">Happy building, and may your pages load faster than a Squatch sighting disappears.</p>
				<p class="release">ssqch {{ latest.version }} is the latest release.</p>
			</div>
			<nav aria-labelledby="footer-docs">
				<h2 id="footer-docs">Docs</h2>
				<ul>
					<li><a href="{{ links.install }}">Install</a></li>
					<li><a href="{{ links.fieldGuide }}">Field guide</a></li>
					<li><a href="{{ links.trailheads }}">Trailheads</a></li>
					<li><a href="{{ links.knownGaps }}">Known gaps</a></li>
				</ul>
			</nav>
			<nav aria-labelledby="footer-project">
				<h2 id="footer-project">Project</h2>
				<ul>
					<li><a href="/examples/">Examples</a></li>
					<li><a href="{{ links.changelog }}">Trail log</a></li>
					<li><a href="{{ links.benchmarks }}">Benchmarks</a></li>
					<li><a href="{{ site.repo }}">GitHub</a></li>
				</ul>
			</nav>
			<nav aria-labelledby="footer-help">
				<h2 id="footer-help">Help</h2>
				<ul>
					<li><a href="{{ links.agents }}">Scripts and coding agents</a></li>
					<li><a href="/llms.txt">llms.txt</a></li>
					<li><a href="{{ links.issues }}">Report a sighting (open an issue)</a></li>
					<li><a href="{{ links.contributing }}">Working on SiteSquatch</a></li>
				</ul>
			</nav>
		</div>
	</footer>
</body>
</html>
