---
layout: base.jinja
---
{#- One changelog entry: what's new in a minor release, for people. -#}
<article class="entry" data-pagefind-body>
	<div class="wrap entry-wrap">
		<p class="kicker"><a href="/changelog/">Changelog</a> · ssqch {{ release }}{% if lastRelease %} to {{ lastRelease }}{% endif %}</p>
		<h1>{{ title }}</h1>
		<p class="entry-date"><time datetime="{{ updated }}">{{ (lastDate or page.date) | dateformat("%-d %B %Y") }}</time></p>
		<div class="entry-body">
{{ content }}
		</div>
		<p class="entry-notes"><a href="{{ notes }}">Every change in {% if lastRelease %}{{ release }} to {{ lastRelease }}{% else %}{{ release }}{% endif %}, in detail</a> (CHANGELOG.md)</p>
		<p><a class="sign back" href="/changelog/">All the entries</a></p>
	</div>
</article>
