(( $+functions[_ssqch_commands] )) ||
_ssqch_commands() {
    local commands; commands=(
'build:Build the site (default)' \
'serve:Build, serve, watch for changes and live-reload the browser' \
'new:Create a page from a blueprint (a file in _blueprints/), with its title and date filled in' \
'inspect:Show where a page comes from, and which level of the data cascade set each value' \
'completions:Print a completion script for your shell, so Tab finishes commands and options' \
'diff:Compare two builds of a site\: URLs added and removed, and what changed on each page' \
'footprint:Show how much a build weighs\: its files by kind, and the heaviest pages and files' \
'init:Create a starter site (config, layout, five posts, data and editor types)' \
'types:Write ssqch.d.ts, the types editors use for ssqch.config.js' \
'baseline:Build the site with its old generator in fresh copies and compare the builds' \
'import:Move a site from another generator\: rename and rewrite what'\''s mechanical, and list the rest' \
'capabilities:Say what this binary supports\: template languages, modules, config options and optional features' \
'docs:Read the documentation for this version\: a command, config option, function or topic' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'ssqch commands' commands "$@"
}
