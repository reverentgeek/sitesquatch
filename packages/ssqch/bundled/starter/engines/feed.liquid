---
permalink: /feed.xml
excludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ "/feed.xml" | absoluteUrl: site.url }}" rel="self"/>
  <link href="{{ "/" | absoluteUrl: site.url }}"/>
  <id>{{ "/" | absoluteUrl: site.url }}</id>
  <updated>{{ collections.posts | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
  <author><name>{{ site.title }}</name></author>
  {%- for post in collections.newestPosts %}
  {%- assign url = post.url | absoluteUrl: site.url %}
  <entry>
    <title>{{ post.data.title | escape }}</title>
    <link href="{{ url }}"/>
    <id>{{ url }}</id>
    <updated>{{ post.date | dateToRfc3339 }}</updated>
    {%- comment %} Liquid prints HTML as it is: the feed's copy is escaped, as type="html" says. {% endcomment %}
    <content type="html">{{ post.templateContent | feedHtml: url | escape }}</content>
  </entry>
  {%- endfor %}
</feed>
