---
permalink: /feed.xml
excludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{site.title}}</title>
  <subtitle>{{site.description}}</subtitle>
  <link href="{{absoluteUrl "/feed.xml" site.url}}" rel="self"/>
  <link href="{{absoluteUrl "/" site.url}}"/>
  <id>{{absoluteUrl "/" site.url}}</id>
  <updated>{{dateToRfc3339 (getNewestCollectionItemDate collections.posts)}}</updated>
  <author><name>{{site.title}}</name></author>
  {{#each collections.newestPosts}}
  <entry>
    <title>{{data.title}}</title>
    <link href="{{absoluteUrl url @root.site.url}}"/>
    <id>{{absoluteUrl url @root.site.url}}</id>
    <updated>{{dateToRfc3339 date}}</updated>
    <content type="html">{{feedHtml templateContent (absoluteUrl url @root.site.url)}}</content>
  </entry>
  {{/each}}
</feed>
