<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{#if title}}{{title}} | {{/if}}{{site.name}}</title>
  <meta name="description" content="{{#if description}}{{description}}{{else}}{{site.description}}{{/if}}">
  <link rel="canonical" href="{{site.url}}{{page.url}}">
  {{!-- For agents: the page as Markdown and the site's map (llmsPlugin() in ssqch.config.js). --}}
  {{#with (markdownCopy page.url)}}<link rel="alternate" type="text/markdown" href="{{this}}">{{/with}}
  <link rel="describedby" href="{{llmsTxt page.url}}">
  <meta name="generator" content="{{ssqch.generator}}">
  <link rel="stylesheet" href="/highlight.css">
  <link rel="stylesheet" href="/assets/docs.css">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  {{#if search}}
  <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css">
  <script src="/pagefind/pagefind-component-ui.js" type="module"></script>
  {{/if}}
  <script src="/assets/docs.js" defer></script>
  {{!-- Before the page is drawn, so a reader who picked a theme doesn't see the other one first. --}}
  <script>try { const theme = localStorage.getItem("theme"); if (theme) document.documentElement.dataset.theme = theme; } catch {}</script>
</head>
<body>
  <a class="skip-link" href="#content">Skip to content</a>
  <header class="site-header">
    <a class="site-name" href="/">{{site.name}}</a>
    <nav aria-label="Site">
      <a href="/docs/">Docs</a>
      {{#if sidebar}}
      <a class="menu-link" href="#sidebar">Menu</a>
      {{/if}}
    </nav>
    {{#if search}}
    <div id="search"><pagefind-config bundle-path="{{withBase "/pagefind/"}}"></pagefind-config><pagefind-modal-trigger></pagefind-modal-trigger><pagefind-modal></pagefind-modal></div>
    {{/if}}
    {{!-- docs.js shows it. Without JavaScript, the theme follows the system. --}}
    <button class="theme-switch" type="button" hidden>Switch theme</button>
  </header>
  {{#if sidebar}}
  {{{content}}}
  {{else}}
  <main id="content">{{{content}}}</main>
  {{/if}}
</body>
</html>
