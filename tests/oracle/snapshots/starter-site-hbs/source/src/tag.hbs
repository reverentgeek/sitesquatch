---
layout: layout.hbs
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: /tags/{{slugify tag.name}}/
computed:
  title: "Tagged {{tag.name}}"
---
<ul>
  {{#each tag.posts}}
    <li><a href="{{url}}">{{data.title}}</a> ({{readableDate date}})</li>
  {{/each}}
</ul>
<p><a href="/tags/">Every tag</a></p>
