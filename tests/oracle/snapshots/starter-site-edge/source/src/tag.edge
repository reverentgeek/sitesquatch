---
layout: layout.edge
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: /tags/{{ slugify(tag.name) }}/
computed:
  title: "Tagged {{ tag.name }}"
---
<ul>
  @each(post in tag.posts)
    <li><a href="{{ post.url }}">{{ post.data.title }}</a> ({{ readableDate(post.date) }})</li>
  @end
</ul>
<p><a href="/tags/">Every tag</a></p>
