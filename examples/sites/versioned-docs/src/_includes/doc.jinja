---
layout: base.jinja
---
{% set sidebar = sidebars[version] %}
<div class="layout">
<aside>
  {% for section in sidebar | navTree(page.url) %}
  <h2>{{ section.title }}</h2>
  <ul>
    {% for item in section.items %}
    <li><a href="{{ item.url }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
    {% endfor %}
  </ul>
  {% endfor %}
</aside>
<main>
  {% if version == 'next' %}
  <p class="banner">This is unreleased documentation. For the latest version, see <a href="{{ inVersion(page.url, '1.0', collections.all) }}">1.0</a>.</p>
  {% endif %}
  <h1>{{ title }}</h1>
  {{ content }}
  {% set pager = sidebar | navPager(page.url) %}
  <nav class="pager">
    <span>
      {% if pager.previous %}
      <a href="{{ pager.previous.url }}">← {{ pager.previous.title }}</a>
      {% endif %}
    </span>
    <span>
      {% if pager.next %}
      <a href="{{ pager.next.url }}">{{ pager.next.title }} →</a>
      {% endif %}
    </span>
  </nav>
</main>
</div>
