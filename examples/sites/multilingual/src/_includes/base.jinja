{#- On a fallback page, `stand_in.page` is the page it copies (src/fallback.jinja). -#}
{%- set original = stand_in.page if stand_in else none -%}
{%- set versions = key | versions -%}
{%- set translated = versions | selectattr("translated") | list -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} | {{ "site" | t(lang) }}</title>
{% if original %}
{# A fallback page is a copy of the original: search engines should list that one. #}
<link rel="canonical" href="{{ original.url }}">
{% elif translated | length > 1 %}
{# Each real translation, the page itself included, and the default language for everyone else. #}
{% for v in translated %}<link rel="alternate" hreflang="{{ v.lang }}" href="{{ v.url }}">
{% endfor %}<link rel="alternate" hreflang="x-default" href="{{ translated[0].url }}">
{% endif %}
<style>
  /* Ranger Station '76: soft white (green charcoal in dark mode), pine headings and navigation,
     burnt orange links, avocado for the selected language, harvest gold for the notice, and the
     four-color stripe under the header. */
  :root { color-scheme: light dark; --page: #fafaf7; --text: #29332c; --heading: #233b2b; --link: #a23e20; --selected: #e6ecda; --callout: #f6efdf; --stripe-pine: #233b2b; }
  @media (prefers-color-scheme: dark) { :root { --page: #1b201d; --text: #e5e9e1; --heading: #d6e4c8; --link: #f0a17d; --selected: #2e3f2b; --callout: #2e2b21; --stripe-pine: #2e5a3c; } }
  body { color: var(--text); background: var(--page); font: 17px/1.6 system-ui, sans-serif; margin: 0; }
  h1, h2 { color: var(--heading); }
  a { color: var(--link); text-underline-offset: 0.18em; }
  header { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; padding: 0.75rem 1rem; border-bottom: 5px solid; border-image: linear-gradient(to right, var(--stripe-pine) 0 25%, #a23e20 25% 50%, #e8af43 50% 75%, #a9b66a 75%) 1; }
  header a { color: var(--heading); }
  header nav { display: flex; gap: 1rem; }
  .languages a[aria-current] { background: var(--selected); border-bottom: 3px solid #a9b66a; text-decoration: none; padding: 0 0.3rem; }
  .notice { background: var(--callout); border-left: 4px solid #e8af43; padding: 0.5rem 1rem; }
  main, footer { padding: 1rem 2rem; max-width: 46rem; }
</style>
</head>
<body>
<header>
  <nav>
    <a href="/{{ lang }}/">{{ "nav.home" | t(lang) }}</a>
    {% for v in "trails" | versions %}{% if v.lang == lang %}<a href="{{ v.url }}">{{ "nav.trails" | t(lang) }}</a>{% endif %}{% endfor %}
    {% for v in "snacks" | versions %}{% if v.lang == lang %}<a href="{{ v.url }}">{{ "nav.snacks" | t(lang) }}</a>{% endif %}{% endfor %}
  </nav>
  <nav class="languages" aria-label="{{ "language" | t(lang) }}">
    {% for v in versions %}
    <a href="{{ v.url }}" hreflang="{{ v.lang }}" lang="{{ v.lang }}"{% if v.lang == lang %} aria-current="true"{% endif %}>{{ v.name }}</a>
    {% endfor %}
  </nav>
</header>
<main{% if original %} lang="{{ original.data.lang }}"{% endif %}>
  {% if original %}<p class="notice" lang="{{ lang }}">{{ "untranslated" | t(lang) }}</p>{% endif %}
  <h1>{{ title }}</h1>
  {{ content }}
</main>
<footer>{{ "footer" | t(lang) }}</footer>
</body>
</html>
