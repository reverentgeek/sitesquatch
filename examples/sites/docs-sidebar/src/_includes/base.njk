<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
<link rel="stylesheet" href="/highlight.css">
<link rel="stylesheet" href="/pagefind/pagefind-ui.css">
<script src="/pagefind/pagefind-ui.js" defer></script>
<script>addEventListener("DOMContentLoaded", () => window.PagefindUI && new PagefindUI({ element: "#search", showSubResults: true }));</script>
<style>
  /* Ranger Station '76: soft white (green charcoal in dark mode), pine headings and navigation,
     burnt orange links, avocado for what's selected and for code, harvest gold callouts, and
     the four-color stripe under the header. */
  :root { color-scheme: light dark; --page: #fafaf7; --text: #29332c; --heading: #233b2b; --muted: #5e6a61; --link: #a23e20; --rule: #dcddd4; --panel: #f1f1eb; --surface: #eeefe7; --code: #3f5a2a; --selected: #e6ecda; --callout: #f6efdf; --stripe-pine: #233b2b; }
  @media (prefers-color-scheme: dark) { :root { --page: #1b201d; --text: #e5e9e1; --heading: #d6e4c8; --muted: #a2aca3; --link: #f0a17d; --rule: #3a413b; --panel: #222924; --surface: #252b27; --code: #b9c77e; --selected: #2e3f2b; --callout: #2e2b21; --stripe-pine: #2e5a3c; } }
  body { color: var(--text); background: var(--page); }
  h1, h2, h3 { color: var(--heading); }
  a { color: var(--link); text-underline-offset: 0.18em; }
  code { color: var(--code); }
  pre code { color: inherit; }
  pre { background: var(--surface); border-left: 3px solid #a9b66a; }
  .stripe, body > header { border-bottom: 5px solid; border-image: linear-gradient(to right, var(--stripe-pine) 0 25%, #a23e20 25% 50%, #e8af43 50% 75%, #a9b66a 75%) 1; }
  body { font: 17px/1.6 system-ui, sans-serif; margin: 0; display: grid; grid-template-columns: 15rem 1fr 13rem; }
  aside { padding: 1rem; font-size: 0.9em; }
  .sidebar { background: var(--panel); min-height: 100vh; }
  .sidebar h2 { font-size: 0.8em; text-transform: uppercase; margin-bottom: 0.25rem; }
  .sidebar ul, .toc ul { list-style: none; padding-left: 0.75rem; margin: 0; }
  .sidebar a { color: var(--heading); text-decoration: none; }
  .sidebar a[aria-current] { font-weight: bold; background: var(--selected); border-left: 3px solid #a9b66a; padding-left: 0.4rem; }
  main { padding: 1rem 2rem; min-width: 0; }
  pre { padding: 1rem; overflow-x: auto; }
  .anchor { opacity: 0.4; text-decoration: none; margin-left: 0.3em; }
  .tip, .warning, details, .markdown-alert { border-left: 4px solid #e8af43; background: var(--callout); padding: 0.25rem 1rem; margin: 1rem 0; }
  .tip { border-color: #a9b66a; } .warning { border-color: #e8af43; } details { border-color: var(--stripe-pine); } .markdown-alert { border-color: #e8af43; }
  .container-title, .markdown-alert-title { font-weight: bold; color: var(--heading); }
  .pager { display: flex; justify-content: space-between; margin-top: 3rem; }
  @media (max-width: 60rem) { body { display: block; } .sidebar { min-height: 0; } }
  html { border-top: 5px solid; border-image: linear-gradient(to right, var(--stripe-pine) 0 25%, #a23e20 25% 50%, #e8af43 50% 75%, #a9b66a 75%) 1; }
  /* Code in the palette, over /highlight.css's colors. */
  html:root { --hl-comment: #5e6a61; --hl-keyword: #a23e20; --hl-operator: #a23e20; --hl-string: #4e5e24; --hl-regexp: #4e5e24; --hl-escape: #4e5e24; --hl-number: #7a500a; --hl-constant: #7a500a; --hl-builtin: #7a500a; --hl-property: #233b2b; --hl-attribute: #7a500a; --hl-function: #233b2b; --hl-type: #7a500a; --hl-parameter: #7a500a; --hl-tag: #a23e20; --hl-heading: #a23e20; --hl-link: #a23e20; --hl-inserted: #4e5e24; --hl-inserted-bg: #e6ecda; --hl-deleted: #a23e20; --hl-deleted-bg: #f8eae4; --hl-line-bg: rgba(232, 175, 67, 0.25); }
  @media (prefers-color-scheme: dark) { html:root { --hl-comment: #a2aca3; --hl-keyword: #f0a17d; --hl-operator: #f0a17d; --hl-string: #b9c77e; --hl-regexp: #b9c77e; --hl-escape: #b9c77e; --hl-number: #e8af43; --hl-constant: #e8af43; --hl-builtin: #e8af43; --hl-property: #e5e9e1; --hl-attribute: #e8af43; --hl-function: #d6e4c8; --hl-type: #e8af43; --hl-parameter: #e8af43; --hl-tag: #f0a17d; --hl-heading: #f0a17d; --hl-link: #f0a17d; --hl-inserted: #b9c77e; --hl-inserted-bg: #2e3f2b; --hl-deleted: #f0a17d; --hl-deleted-bg: #33241f; --hl-line-bg: rgba(232, 175, 67, 0.15); } }
  /* Pagefind's search box in the palette. */
  html:root { --pagefind-ui-primary: #a23e20; --pagefind-ui-text: #29332c; --pagefind-ui-background: #fafaf7; --pagefind-ui-border: #dcddd4; --pagefind-ui-tag: #eeefe7; }
  @media (prefers-color-scheme: dark) { html:root { --pagefind-ui-primary: #f0a17d; --pagefind-ui-text: #e5e9e1; --pagefind-ui-background: #252b27; --pagefind-ui-border: #3a413b; --pagefind-ui-tag: #2e3f2b; } }
</style>
</head>
<body>
<aside class="sidebar">
  <p><a href="/">{{ site.title }}</a></p>
  <div id="search"></div>
  {# navTree marks the current page and the section it's in. #}
  {% for section in nav | navTree(page.url) %}
  <h2{% if section.open %} class="open"{% endif %}>{{ section.title }}</h2>
  <ul>
    {% for item in section.pages %}
    <li><a href="{{ item.url }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
    {% endfor %}
  </ul>
  {% endfor %}
</aside>
<main data-pagefind-body>
{{ content | safe }}
</main>
<aside class="toc">
  {% set contents = toc(page.headings) %}
  {% if contents %}<p><strong>On this page</strong></p>{{ contents | safe }}{% endif %}
</aside>
</body>
</html>
