<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
<link rel="stylesheet" href="/highlight.css">
<style>
  body { font: 17px/1.6 system-ui, sans-serif; margin: 0; display: grid; grid-template-columns: 15rem 1fr 13rem; }
  aside { padding: 1rem; font-size: 0.9em; }
  .sidebar { background: #f6f8fa; min-height: 100vh; }
  .sidebar h2 { font-size: 0.8em; text-transform: uppercase; margin-bottom: 0.25rem; }
  .sidebar ul, .toc ul { list-style: none; padding-left: 0.75rem; margin: 0; }
  .sidebar a[aria-current] { font-weight: bold; }
  main { padding: 1rem 2rem; min-width: 0; }
  pre { background: #f6f8fa; padding: 1rem; overflow-x: auto; }
  .anchor { opacity: 0.3; text-decoration: none; margin-left: 0.3em; }
  .tip, .warning, details, .markdown-alert { border-left: 4px solid; padding: 0.25rem 1rem; margin: 1rem 0; }
  .tip { border-color: #1a7f37; } .warning { border-color: #bf8700; } details { border-color: #8250df; } .markdown-alert { border-color: #0969da; }
  .container-title, .markdown-alert-title { font-weight: bold; }
  .pager { display: flex; justify-content: space-between; margin-top: 3rem; }
  @media (max-width: 60rem) { body { display: block; } .sidebar { min-height: 0; } }
  @media (prefers-color-scheme: dark) { body { background: #0d1117; color: #e6edf3; } a { color: #58a6ff; } .sidebar, pre { background: #161b22; } }
</style>
</head>
<body>
<aside class="sidebar">
  <p><a href="/">{{ site.title }}</a></p>
  {% for section in nav %}
  <h2>{{ section.title }}</h2>
  <ul>
    {% for item in section.pages %}
    <li><a href="{{ item.url }}"{% if item.url == page.url %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
    {% endfor %}
  </ul>
  {% endfor %}
</aside>
<main>
{{ content | safe }}
</main>
<aside class="toc">
  {% set contents = toc(page.headings) %}
  {% if contents %}<p><strong>On this page</strong></p>{{ contents | safe }}{% endif %}
</aside>
</body>
</html>
